{
  "name": "secrets",
  "version": "1.0.0",
  "rules": [
    {
      "id": "aws-access-key-id",
      "type": "regex",
      "pattern": "(AKIA|ASIA)[0-9A-Z]{16}",
      "description": "AWS access key id",
      "severity": "critical",
      "remediation": "Deactivate the key in IAM, issue a new one, and load it from the environment or a secrets manager instead of source control.",
      "maxMatchLength": 20
    },
    {
      "id": "private-key-block",
      "type": "regex",
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY( BLOCK)?-----",
      "description": "PEM private key header",
      "severity": "critical",
      "remediation": "Treat the key as compromised: generate a replacement, redeploy it, and purge the old key from history.",
      "maxMatchLength": 64
    },
    {
      "id": "github-token",
      "type": "regex",
      "pattern": "gh[pousr]_[A-Za-z0-9]{36,255}",
      "description": "GitHub personal access or app token",
      "severity": "critical",
      "remediation": "Revoke the token in GitHub settings and replace it with a fine-grained token stored in CI secrets.",
      "maxMatchLength": 260
    },
    {
      "id": "slack-token",
      "type": "regex",
      "pattern": "xox[abprs]-[0-9A-Za-z-]{10,250}",
      "description": "Slack API token",
      "severity": "high",
      "remediation": "Revoke the token from the Slack app configuration and store the replacement outside the repository.",
      "maxMatchLength": 260
    },
    {
      "id": "google-api-key",
      "type": "regex",
      "pattern": "AIza[0-9A-Za-z_-]{35}",
      "description": "Google API key",
      "severity": "high",
      "remediation": "Regenerate the key in Google Cloud Console and restrict it to the required APIs and referrers.",
      "maxMatchLength": 39
    },
    {
      "id": "stripe-secret-key",
      "type": "regex",
      "pattern": "sk_(live|test)_[0-9a-zA-Z]{24,99}",
      "description": "Stripe secret key",
      "severity": "critical",
      "remediation": "Roll the key in the Stripe dashboard and move it to the deployment's secret store.",
      "maxMatchLength": 110
    },
    {
      "id": "jwt-token",
      "type": "regex",
      "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
      "description": "JSON Web Token",
      "severity": "medium",
      "remediation": "Invalidate the token server-side if it is still valid and stop committing session material.",
      "maxMatchLength": 4096
    },
    {
      "id": "password-assignment",
      "type": "regex",
      "pattern": "(password|passwd|pwd)\\s*[=:]\\s*['\"]?[^\\s'\"]{4,}",
      "description": "Password assigned in plain text",
      "severity": "high",
      "remediation": "Read the password from an environment variable or secret store and rotate the exposed value.",
      "maxMatchLength": 256,
      "flags": ["icase"]
    },
    {
      "id": "generic-api-key",
      "type": "regex",
      "pattern": "(api[_-]?key|apikey|secret[_-]?key)\\s*[=:]\\s*['\"]?[A-Za-z0-9_\\-]{16,}",
      "description": "Generic API key assignment",
      "severity": "medium",
      "remediation": "Move the key to configuration injected at deploy time and rotate it with the provider.",
      "maxMatchLength": 256,
      "flags": ["icase"]
    }
  ]
}
